{
    "info":  {
                 "name":  "RepoDNA API",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "variable":  [
                     {
                         "key":  "baseUrl",
                         "value":  "http://localhost:8080"
                     },
                     {
                         "key":  "email",
                         "value":  "postman.user@example.com"
                     },
                     {
                         "key":  "internalKey",
                         "value":  "PUT_YOUR_INTERNAL_API_KEY_HERE"
                     },
                     {
                         "key":  "token",
                         "value":  ""
                     },
                     {
                         "key":  "jobId",
                         "value":  ""
                     }
                 ],
    "item":  [
                 {
                     "name":  "1. Register",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/auth/register",
                                     "body":  {
                                                  "raw":  "{\"email\":\"{{email}}\",\"password\":\"password123\"}",
                                                  "mode":  "raw"
                                              }
                                 },
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "var j = pm.response.json(); pm.collectionVariables.set(\"token\", j.token || j.accessToken || j.access_token);"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "name":  "2. Login (use if Register says 409)",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/auth/login",
                                     "body":  {
                                                  "raw":  "{\"email\":\"{{email}}\",\"password\":\"password123\"}",
                                                  "mode":  "raw"
                                              }
                                 },
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "var j = pm.response.json(); pm.collectionVariables.set(\"token\", j.token || j.accessToken || j.access_token);"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "name":  "3. Create job",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/jobs",
                                     "auth":  {
                                                  "bearer":  [
                                                                 {
                                                                     "key":  "token",
                                                                     "type":  "string",
                                                                     "value":  "{{token}}"
                                                                 }
                                                             ],
                                                  "type":  "bearer"
                                              },
                                     "body":  {
                                                  "raw":  "{\"repo_url\":\"https://github.com/repodna-demo/mini-flask-shop\"}",
                                                  "mode":  "raw"
                                              }
                                 },
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "var j = pm.response.json(); pm.collectionVariables.set(\"jobId\", j.id || j.job_id || j.jobId);"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "name":  "4. List jobs",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [

                                                ],
                                     "url":  "{{baseUrl}}/jobs",
                                     "auth":  {
                                                  "bearer":  [
                                                                 {
                                                                     "key":  "token",
                                                                     "type":  "string",
                                                                     "value":  "{{token}}"
                                                                 }
                                                             ],
                                                  "type":  "bearer"
                                              }
                                 }
                 },
                 {
                     "name":  "5. Get job",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [

                                                ],
                                     "url":  "{{baseUrl}}/jobs/{{jobId}}",
                                     "auth":  {
                                                  "bearer":  [
                                                                 {
                                                                     "key":  "token",
                                                                     "type":  "string",
                                                                     "value":  "{{token}}"
                                                                 }
                                                             ],
                                                  "type":  "bearer"
                                              }
                                 }
                 },
                 {
                     "name":  "6. Worker: status RUNNING",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "X-Internal-Key",
                                                        "value":  "{{internalKey}}"
                                                    },
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/internal/jobs/{{jobId}}/status",
                                     "body":  {
                                                  "raw":  "{\"status\":\"RUNNING\"}",
                                                  "mode":  "raw"
                                              }
                                 }
