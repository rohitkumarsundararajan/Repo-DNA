{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repodna.dev/schemas/result.schema.json",
  "title": "AnalysisResult",
  "description": "Final result posted by the worker to POST /internal/jobs/{id}/result. Stored as job_results.result (jsonb) and served back via GET /jobs/{id}/result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "repo_meta", "languages", "frameworks",
    "files", "hotspots", "graph", "cycles", "architecture", "scores"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Bump on any breaking change to this schema. All 3 backend members must agree before bumping."
    },
    "job_id": { "type": "string", "format": "uuid" },

    "repo_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_url", "source_type", "total_files", "total_loc"],
      "properties": {
        "repo_url": { "type": ["string", "null"] },
        "source_type": { "type": "string", "enum": ["git", "zip"] },
        "total_files": { "type": "integer", "minimum": 0 },
        "total_loc": { "type": "integer", "minimum": 0 },
        "analyzed_at": { "type": "string", "format": "date-time" }
      }
    },

    "languages": {
      "type": "array",
      "description": "Output of Sakthi's language-detection step, sorted by share of code.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "file_count", "loc", "percentage"],
        "properties": {
          "name": { "type": "string" },
          "file_count": { "type": "integer", "minimum": 0 },
          "loc": { "type": "integer", "minimum": 0 },
          "percentage": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },

    "frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" }
        }
      }
    },

    "files": {
      "type": "array",
      "description": "One entry per source file, from Sakthi's metrics aggregate.py.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "loc", "cyclomatic", "cognitive", "max_nesting"],
        "properties": {
          "path": { "type": "string" },
          "loc": { "type": "integer", "minimum": 0 },
          "cyclomatic": { "type": "integer", "minimum": 0 },
          "cognitive": { "type": "integer", "minimum": 0 },
          "max_nesting": { "type": "integer", "minimum": 0 }
        }
      }
    },

    "hotspots": {
      "type": "array",
      "description": "Top offenders picked out by Sakthi's metrics builder (task 11), so the Frontend dashboard's 'top complexity hotspots' bar chart doesn't have to re-derive this by re-sorting files[] itself. Each entry references a file already present in files[] by path.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "metric", "value"],
        "properties": {
          "path": { "type": "string" },
          "metric": {
            "type": "string",
            "enum": ["cyclomatic", "cognitive", "max_nesting", "loc"],
            "description": "Which metric this file was flagged for."
          },
          "value": { "type": "number", "minimum": 0 }
        }
      }
    },

    "graph": {
      "type": "object",
      "description": "Dependency graph from Venky's builder.py.",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "language", "folder", "fan_in", "fan_out"],
            "properties": {
              "path": { "type": "string" },
              "language": { "type": "string" },
              "folder": { "type": "string" },
              "fan_in": { "type": "integer", "minimum": 0 },
              "fan_out": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        }
      }
    },

    "cycles": {
      "type": "array",
      "description": "Each cycle as an ordered file-path list, from Venky's cycles.py. minItems is 2 (A->B->A); if a self-import (A->A) is ever produced by the resolver, decide whether to represent it here or filter it out before assembly -- this schema currently rejects a 1-item cycle.",
      "items": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 2
      }
    },

    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "evidence", "violations"],
      "properties": {
        "pattern": {
          "type": "string",
          "enum": ["layered", "mvc", "microservices", "unknown"]
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files/edges that triggered the pattern decision."
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "rule"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "rule": { "type": "string" }
            }
          }
        }
      }
    },

    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture_dna", "code_dna", "quality_dna"],
      "properties": {
        "architecture_dna": { "type": "number", "minimum": 0, "maximum": 100 },
        "code_dna": { "type": "number", "minimum": 0, "maximum": 100 },
        "quality_dna": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}