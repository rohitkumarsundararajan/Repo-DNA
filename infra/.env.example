# Copy to .env and fill in real values. Never commit .env itself.

# Postgres
POSTGRES_USER=repodna
POSTGRES_PASSWORD=changeme
POSTGRES_DB=repodna

# Shared connection settings (each service builds its own DB_URL format
# internally in docker-compose.yml)
REDIS_HOST=redis

# Secrets
JWT_SECRET=changeme-generate-a-long-random-string
INTERNAL_API_KEY=changeme-generate-a-long-random-string
