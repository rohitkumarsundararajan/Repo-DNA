{$API_DOMAIN} {
	encode gzip zstd

	# Worker callbacks are for the compose network only. Never expose them publicly.
	@internal path /internal/*
	respond @internal 404

	# Slightly above Spring's max-request-size (55MB), so Spring can return its own clean error
	request_body {
		max_size 60MB
	}

	reverse_proxy api-service:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
